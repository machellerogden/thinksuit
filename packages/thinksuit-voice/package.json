{
    "name": "thinksuit-voice",
    "version": "0.1.3",
    "private": true,
    "description": "Hands-free voice front door for ThinkSuit: wake word -> speech -> turn -> spoken response",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/machellerogden/thinksuit.git",
        "directory": "packages/thinksuit-voice"
    },
    "bugs": {
        "url": "https://github.com/machellerogden/thinksuit/issues"
    },
    "homepage": "https://github.com/machellerogden/thinksuit/tree/main/packages/thinksuit-voice#readme",
    "main": "./src/index.js",
    "exports": {
        ".": "./src/index.js",
        "./devices": "./src/audio/devices.js",
        "./control": "./src/control/client.js",
        "./wakewords": "./src/wakewords/store.js",
        "./session": "./src/session.js",
        "./recorder": "./src/wakewords/recorder.js",
        "./training-worker": "./bin/train.mjs",
        "./service": "./service.js"
    },
    "bin": {
        "thinksuit-voice": "bin/ctl.mjs"
    },
    "scripts": {
        "dev": "node ./bin/service.mjs",
        "detect": "node ./tools/detect.mjs",
        "test": "vitest --config ../../vitest.config.js"
    },
    "keywords": [
        "thinksuit",
        "voice",
        "wakeword",
        "stt",
        "tts"
    ],
    "author": {
        "name": "Mac Heller-Ogden",
        "email": "mac@machellerogden.com"
    },
    "license": "Apache-2.0",
    "dependencies": {
        "@huggingface/transformers": "^4.2.0",
        "naudiodon2": "^2.4.0",
        "onnxruntime-node": "^1.20.0",
        "thinksuit": "*",
        "thinksuit-broker": "*",
        "thinksuit-log": "*"
    },
    "engines": {
        "node": ">=22"
    }
}
