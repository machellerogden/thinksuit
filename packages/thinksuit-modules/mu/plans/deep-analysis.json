{
    "name": "Deep Analysis",
    "description": "Multi-stage investigation, analysis, and synthesis. Gather file information (investigate), reason about structure and patterns (analyze), then present a coherent report (synthesize); only the final synthesized report is returned.",
    "type": "sequence",
    "resultStrategy": "last",
    "children": [
        {
            "type": "task",
            "role": "investigate",
            "tools": [
                "list_directory",
                "read_text_file",
                "read_media_file",
                "read_multiple_files"
            ],
            "maxRounds": 5,
            "timeoutMs": 43200000,
            "params": {
                "lengthLevel": "standard",
                "maxTokens": 10000
            }
        },
        {
            "type": "task",
            "role": "analyze",
            "tools": [],
            "maxRounds": 3,
            "timeoutMs": 43200000,
            "params": {
                "lengthLevel": "standard",
                "maxTokens": 10000
            }
        },
        {
            "type": "task",
            "role": "synthesize",
            "maxRounds": 1,
            "params": {
                "lengthLevel": "comprehensive",
                "maxTokens": 10000
            }
        }
    ]
}
