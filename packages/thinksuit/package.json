{
    "name": "thinksuit",
    "version": "0.1.3",
    "description": "Core orchestration engine for ThinkSuit - state machine-based AI execution with signal detection and modular cognitive architecture",
    "type": "module",
    "main": "index.js",
    "bin": {
        "thinksuit-exec": "./engine/execute.js"
    },
    "exports": {
        ".": "./index.js",
        "./sessions/tree": "./engine/sessions/tree.js",
        "./config": "./engine/config.js",
        "./frames": "./frames.js",
        "./sessions/deriveSessionStatus": "./engine/sessions/deriveSessionStatus.js",
        "./constants/events": "./engine/constants/events.js",
        "./schemas/validate": "./schemas/validate.js",
        "./schemas/plan.v1.json": "./schemas/plan.v1.json",
        "./engine/mcp/client": "./engine/mcp/client.js",
        "./engine/mcp/discovery": "./engine/mcp/discovery.js",
        "./engine/mcp/factory": "./engine/mcp/factory.js",
        "./engine/mcp/policy": "./engine/mcp/policy.js"
    },
    "directories": {
        "doc": "docs",
        "test": "tests"
    },
    "scripts": {
        "exec": "node engine/execute.js",
        "test": "vitest --config ../../vitest.config.js",
        "test:ui": "vitest --ui --config ../../vitest.config.js",
        "test:coverage": "vitest --coverage --config ../../vitest.config.js",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "publish": "npm publish --access public"
    },
    "keywords": [
        "ai",
        "orchestration",
        "llm",
        "agent"
    ],
    "author": {
        "name": "Mac Heller-Ogden",
        "email": "mac@machellerogden.com"
    },
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/machellerogden/thinksuit.git",
        "directory": "packages/thinksuit"
    },
    "bugs": {
        "url": "https://github.com/machellerogden/thinksuit/issues"
    },
    "homepage": "https://github.com/machellerogden/thinksuit/tree/main/packages/thinksuit#readme",
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.19.1",
        "chokidar": "^5.0.0",
        "gray-matter": "^4.0.3",
        "is-online": "^12.0.1",
        "jsonschema": "^1.5.0",
        "meow": "^14.1.0",
        "p-queue": "^9.3.0",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "thinksuit-genai": "*",
        "thinksuit-modules": "*",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.33.0",
        "eslint": "^9.37.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "jscodeshift": "^17.3.0",
        "prettier": "^3.6.2",
        "vite": "^7.1.2"
    },
    "engines": {
        "node": ">=22"
    }
}
