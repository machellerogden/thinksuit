<!-- Template. Rendered by scripts/install.mjs to ~/Library/LaunchAgents/thinksuit-voice.service.plist. Do not edit the rendered copy; edit this template. ProgramArguments[0] is the .app bundle exe (mic-permission shim) built by bin/service.appbundle.sh, not bare node. -->
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>thinksuit-voice.service</string>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>{{HOME}}/Library/Logs/thinksuit-voice.service.stderr.log</string>
    <key>StandardOutPath</key>
    <string>{{HOME}}/Library/Logs/thinksuit-voice.service.stdout.log</string>
    <key>EnvironmentVariables</key>
    <dict>
      <key>FORCE_COLOR</key>
      <string>true</string>
      <key>PATH</key>
      <string><![CDATA[{{NODE_DIR}}:/opt/homebrew/bin:/usr/local/bin:/usr/local/sbin:/usr/bin:/bin:/usr/sbin:/sbin]]></string>
    </dict>
    <key>WorkingDirectory</key>
    <string>{{REPO}}/packages/thinksuit-voice</string>
    <key>ProgramArguments</key>
    <array>
      <string>{{HOME}}/Applications/ThinkSuit Voice.app/Contents/MacOS/{{VOICE_APP_EXE}}</string>
      <string>bin/service.mjs</string>
    </array>
  </dict>
</plist>
