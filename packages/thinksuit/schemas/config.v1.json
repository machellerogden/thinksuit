{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ThinkSuit User Configuration",
  "description": "Schema for .thinksuit.json user configuration files",
  "type": "object",
  "properties": {
    "module": {
      "type": "string",
      "description": "Module to load (e.g., 'thinksuit/mu')"
    },
    "modulesPackage": {
      "type": "string",
      "description": "Path to custom modules package directory (absolute or relative)"
    },
    "provider": {
      "type": "string",
      "enum": [
        "openai",
        "google",
        "anthropic",
        "hugging-face",
        "onnx"
      ],
      "description": "LLM provider / API gateway"
    },
    "model": {
      "type": "string",
      "description": "Model name (e.g., 'gpt-4o-mini', 'gemini-2.5-pro')"
    },
    "maxDepth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "description": "Maximum recursion depth"
    },
    "maxFanout": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "description": "Maximum parallel branches"
    },
    "maxChildren": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "description": "Maximum child operations"
    },
    "cwd": {
      "type": "string",
      "description": "Working directory for tools (absolute path)"
    },
    "trace": {
      "type": "boolean",
      "description": "Enable execution tracing"
    },
    "silent": {
      "type": "boolean",
      "description": "Suppress all logging output"
    },
    "verbose": {
      "type": "boolean",
      "description": "Enable verbose logging"
    },
    "allowedTools": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of allowed tool names (empty array or omitted means all tools allowed)"
    },
    "allowedDirectories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of allowed directory paths for tool access"
    },
    "mcpServers": {
      "type": "object",
      "description": "MCP server configurations",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "description": "Command to execute"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Command arguments"
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Environment variables"
          }
        },
        "required": [
          "command"
        ]
      }
    },
    "approvalTimeout": {
      "type": "integer",
      "description": "Tool approval timeout in milliseconds (-1 to disable, default: 43200000 = 12 hours)"
    },
    "voice": {
      "type": "object",
      "description": "thinksuit-voice daemon configuration (backend selection + device; never secrets)",
      "properties": {
        "wake": {
          "type": "object",
          "description": "Wake-word detection settings",
          "properties": {
            "phrase": {
              "type": "string",
              "description": "Wake-word phrase slug (selects the classifier head)"
            },
            "threshold": {
              "type": "number",
              "description": "Detection score threshold (0-1)"
            },
            "deviceId": {
              "type": "integer",
              "description": "Input device id (-1 for system default). Fragile across device changes; prefer deviceName."
            },
            "deviceName": {
              "type": "string",
              "description": "Input device name (case-insensitive substring), resolved to the current id at startup. Preferred over deviceId."
            },
            "classifierPath": {
              "type": "string",
              "description": "Explicit path to the classifier .onnx (overrides phrase resolution)"
            }
          },
          "additionalProperties": true
        },
        "stt": {
          "type": "object",
          "description": "Speech-to-text backend selection",
          "properties": {
            "provider": {
              "type": "string",
              "description": "STT provider name (e.g., 'whisper')"
            }
          },
          "additionalProperties": true
        },
        "tts": {
          "type": "object",
          "description": "Text-to-speech backend selection",
          "properties": {
            "provider": {
              "type": "string",
              "description": "TTS provider name (e.g., 'say')"
            }
          },
          "additionalProperties": true
        },
        "capture": {
          "type": "object",
          "description": "Utterance capture / endpointer tuning (post-wake recording)",
          "properties": {
            "rmsThreshold": {
              "type": "number",
              "description": "int16 RMS above which a frame counts as speech (mic-gain dependent)"
            },
            "silenceMs": {
              "type": "integer",
              "description": "Trailing silence (ms) that ends an utterance"
            },
            "startTimeoutMs": {
              "type": "integer",
              "description": "Give up (no turn) if no speech starts within this many ms after wake"
            },
            "maxMs": {
              "type": "integer",
              "description": "Hard cap (ms) on a single utterance length"
            },
            "cueTrimMarginMs": {
              "type": "integer",
              "description": "Added to the start cue's measured duration when trimming the beep off the front of the capture"
            },
            "guardLeadMs": {
              "type": "integer",
              "description": "Silence kept before the detected speech onset so the first word's attack isn't clipped"
            }
          },
          "additionalProperties": true
        },
        "cues": {
          "type": "object",
          "description": "Audio feedback cues (listening start/end/error)",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Play audio cues (false mutes all)"
            },
            "start": {
              "type": "string",
              "description": "Sound file played when capture begins (finishes before recording)"
            },
            "end": {
              "type": "string",
              "description": "Sound file played when an utterance is captured"
            },
            "error": {
              "type": "string",
              "description": "Sound file played on a failed turn (go-look-at-console signal)"
            },
            "working": {
              "type": "string",
              "description": "Sound looped while a turn is in flight (submitted until response)"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "presets": {
      "type": "object",
      "description": "User-defined presets organized by module",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Unique preset identifier"
            },
            "name": {
              "type": "string",
              "description": "Display name for the preset"
            },
            "description": {
              "type": "string",
              "description": "Description of what this preset does"
            },
            "plan": {
              "type": "object",
              "description": "Execution plan configuration"
            }
          },
          "required": [
            "id",
            "name",
            "plan"
          ]
        }
      }
    },
    "frames": {
      "description": "User-defined frames organized by module",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique frame identifier"
          },
          "name": {
            "type": "string",
            "description": "Display name for the frame"
          },
          "description": {
            "type": "string",
            "description": "Description of what this frame provides"
          },
          "text": {
            "type": "string",
            "description": "Frame content text"
          }
        },
        "required": [
          "id",
          "name",
          "text"
        ]
      }
    }
  },
  "additionalProperties": false
}
