{
    "$id": "thinksuit/plan.v1",
    "$ref": "#/definitions/node",
    "definitions": {
        "node": {
            "oneOf": [
                { "$ref": "#/definitions/task" },
                { "$ref": "#/definitions/sequence" },
                { "$ref": "#/definitions/parallel" }
            ]
        },
        "resultStrategy": {
            "enum": ["last", "concat", "label", "formatted"],
            "description": "How to combine child results: 'last' returns final output, 'concat' merges all outputs, 'label' adds role labels, 'formatted' uses the module formatter"
        },
        "params": {
            "type": "object",
            "description": "Open module-knob bag (e.g. lengthLevel, adaptations, maxTokens)",
            "additionalProperties": true
        },
        "task": {
            "type": "object",
            "required": ["type", "role"],
            "properties": {
                "type": { "const": "task" },
                "role": {
                    "type": "string",
                    "description": "Module role indexing prompts/temperature/baseTokens"
                },
                "tools": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Tool allowlist for this task's loop"
                },
                "input": {
                    "type": "string",
                    "description": "Freeform template ($input, $last_response, $<id>_response); omitted = prior result else turn input"
                },
                "id": {
                    "type": "string",
                    "description": "Optional node id; result is published to the context bag as <id>_response"
                },
                "maxRounds": {
                    "type": "number",
                    "description": "Loop bound; direct = 1"
                },
                "timeoutMs": { "type": "number" },
                "params": { "$ref": "#/definitions/params" },
                "name": { "type": "string" },
                "description": { "type": "string" }
            },
            "additionalProperties": false
        },
        "sequence": {
            "type": "object",
            "required": ["type", "children"],
            "properties": {
                "type": { "const": "sequence" },
                "children": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/node" }
                },
                "resultStrategy": { "$ref": "#/definitions/resultStrategy" },
                "id": { "type": "string" },
                "name": { "type": "string" },
                "description": { "type": "string" }
            },
            "additionalProperties": false
        },
        "parallel": {
            "type": "object",
            "required": ["type", "children"],
            "properties": {
                "type": { "const": "parallel" },
                "children": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/node" }
                },
                "resultStrategy": { "$ref": "#/definitions/resultStrategy" },
                "id": { "type": "string" },
                "name": { "type": "string" },
                "description": { "type": "string" }
            },
            "additionalProperties": false
        }
    }
}
